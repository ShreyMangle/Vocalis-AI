# Port configuration
PORT=5000

# Base host URL (required for Twilio webhooks, e.g. ngrok-subdomain.ngrok-free.app)
APP_HOST=localhost:5000

# JWT Authentication secret
JWT_SECRET=hehe-voice-agent-secret-key-12345

# Database URL (leave blank to automatically use SQLite fallback in backend/data/database.sqlite)
DATABASE_URL=

# Anthropic Claude API Key (optional - mock conversations run if empty)
ANTHROPIC_API_KEY=

# Deepgram API Key (optional - mock STT / TTS run if empty)
DEEPGRAM_API_KEY=

# Twilio Credentials (optional - Twilio calls simulated if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe API Credentials (optional - Stripe subscriptions run in local mock if empty)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Free API Integration Keys
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
