# =============================================================================
# VoxAI Backend — Environment Variables
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git — it's in .gitignore

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=VoxAI
ENVIRONMENT=development       # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
# The "+asyncpg" tells SQLAlchemy to use the async driver
DATABASE_URL=postgresql+asyncpg://voxai:voxai_password@localhost:5432/voxai_db

# =============================================================================
# REDIS
# =============================================================================
# Format: redis://HOST:PORT/DB_NUMBER
# DB 0 = default, DB 1 = separate logical database (good for test isolation)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY — REQUIRED
# =============================================================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# This MUST be at least 32 characters. Never use this example value in production.
JWT_SECRET=CHANGE_ME_generate_with_python_secrets_token_hex_32_minimum

# =============================================================================
# AI PROVIDERS (optional — system uses free fallbacks if not set)
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=                 # Free at https://console.groq.com — recommended for dev
GEMINI_API_KEY=

# Default provider used when creating a new agent (free-tier defaults)
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# =============================================================================
# SPEECH PROVIDERS (free-first defaults; upgrade keys optional)
# =============================================================================
DEEPGRAM_API_KEY=             # STT/TTS — optional free credits at https://deepgram.com
CARTESIA_API_KEY=             # TTS — optional at https://cartesia.ai
SARVAM_API_KEY=               # Indian multilingual TTS — optional at https://sarvam.ai
ELEVENLABS_API_KEY=           # Premium TTS — optional at https://elevenlabs.io

DEFAULT_STT_PROVIDER=groq     # "groq" (free tier) or "deepgram"
DEFAULT_TTS_PROVIDER=edge     # "edge" = 100% free Microsoft Edge Neural TTS
DEFAULT_TTS_VOICE=en-IN-NeerjaNeural

# =============================================================================
# TELEPHONY (VoBiz primary for India, Twilio global fallback)
# =============================================================================
DEFAULT_TELEPHONY_PROVIDER=vobiz

# VoBiz (TRAI-compliant India Telephony)
VOBIZ_API_KEY=
VOBIZ_ACCOUNT_ID=
VOBIZ_PHONE_NUMBER=
VOBIZ_BASE_URL=https://api.vobiz.ai/v1

# Twilio (Global Telephony fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# AWS / STORAGE (optional — required for file uploads in production)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=voxai-uploads

# =============================================================================
# OBSERVABILITY (optional)
# =============================================================================
SENTRY_DSN=                   # Get free DSN at https://sentry.io
