# =============================================================================
# VoxAI — .gitignore
# =============================================================================

# ─── Environment / Secrets ────────────────────────────────────────────────────
# NEVER commit these — they contain API keys and passwords
.env
.env.*
!.env.example       # .env.example IS committed (it has no real secrets)
*.pem
*.key

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ─── Docker ───────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it's needed
# But ignore override files with secrets
docker-compose.override.yml
docker-compose.prod.yml     # production config with real secrets

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json       # Keep .vscode/extensions.json (useful to share)
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Uploads / Generated ──────────────────────────────────────────────────────
uploads/
media/
*.mp3
*.wav
*.webm

# ─── Alembic ──────────────────────────────────────────────────────────────────
# Keep alembic/ folder but ignore generated __pycache__
backend/alembic/__pycache__/
